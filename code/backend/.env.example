# Copy to .env (never commit .env). The server reads these from the environment.
PORT=3000
HOST=127.0.0.1
FHE_URL=http://127.0.0.1:8001
FHE_SERVICE_TOKEN=change-me-internal
# Comma-separated bearer tokens accepted on /api/predict
API_TOKENS=change-me-client
# Requests per minute per client (IP + token)
RATE_LIMIT_PER_MIN=20
# Optional HTTPS (otherwise run behind a TLS reverse proxy)
TLS_CERT=
TLS_KEY=
# Local development only: skip bearer-token auth
AUTH_DISABLED=0
